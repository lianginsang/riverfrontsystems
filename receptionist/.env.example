# Copy to .env and fill in. On Render/Railway, set these in the dashboard instead.

# Anthropic (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (console.twilio.com -> Account info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# The Twilio number callers dial, E.164 format. Also used as the "from" for summary texts.
TWILIO_PHONE_NUMBER=+19048672415

# ElevenLabs voice used by ConversationRelay. Twilio provides ElevenLabs voices
# itself, so only the voice ID is needed. Format: VOICE_ID or VOICE_ID-MODEL
# (e.g. UgBBYS2sOqTuMpoF3BR0-v4). Leave blank to use Twilio's default voice.
ELEVENLABS_VOICE_ID=
# Not used by this app (Twilio handles ElevenLabs). Kept for reference only.
ELEVENLABS_API_KEY=

# Your cell, E.164. Gets call summaries by SMS and transferred calls.
OWNER_CELL_NUMBER=+1XXXXXXXXXX

# Public https URL of this server, no trailing slash (your ngrok URL locally,
# your Render/Railway URL in production). Used for the WebSocket URL and for
# Twilio signature validation, so it must match exactly what Twilio calls.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Supabase, for appointment booking (Supabase dashboard -> Project Settings -> API).
# The service role key bypasses row-level security: server-side only, never put it
# in a browser file. Without these two, April can't book and offers to take a message.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
PORT=8080
# Business name used in booking confirmation texts.
BUSINESS_NAME=Riverfront Systems
# Websites allowed to load call transcripts from this server (the staff calendar),
# comma-separated, no trailing slashes. Add your static site's onrender.com URL if
# you use that instead of the custom domain.
CALENDAR_ORIGINS=https://riverfrontsystems.com,https://www.riverfrontsystems.com,http://localhost:8000

# Turn-taking tuning (optional; defaults shown). See "Turn-taking and interruptions" in README.
# EOT_THRESHOLD: 0.5-0.9. Lower = April replies sooner but cuts people off more.
EOT_THRESHOLD=0.7
# INTERRUPT_SENSITIVITY: low, medium, high. Lower = background noise is less likely to cut April off.
INTERRUPT_SENSITIVITY=medium
